<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fgroupboss.ai.psm.operation.contractor.mapper.ContractorCompanyMapper">

    <sql id="companyWhere">
        tenant_id = #{tenantId}
        and deleted = 0
        <if test="keyword != null and keyword != ''">
            and (company_code like concat('%', #{keyword}, '%')
            or company_name like concat('%', #{keyword}, '%'))
        </if>
        <if test="status != null and status != ''">
            and status = #{status}
        </if>
    </sql>

    <select id="countByTenant" resultType="long">
        select count(1) from contractor_company
        <where>
            <include refid="companyWhere"/>
        </where>
    </select>

    <select id="listByTenant" resultType="com.fgroupboss.ai.psm.operation.contractor.model.entity.ContractorCompanyEntity">
        select * from contractor_company
        <where>
            <include refid="companyWhere"/>
        </where>
        order by id desc
        limit #{offset}, #{limit}
    </select>

    <select id="findByCode" resultType="com.fgroupboss.ai.psm.operation.contractor.model.entity.ContractorCompanyEntity">
        select * from contractor_company
        where tenant_id = #{tenantId}
          and company_code = #{companyCode}
          and deleted = 0
        limit 1
    </select>
</mapper>

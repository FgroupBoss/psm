<?xml version="1.0" encoding="UTF-8" ?> <!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"         "http://mybatis.org/dtd/mybatis-3-mapper.dtd"> <mapper namespace="com.fgroupboss.ai.psm.realtime.alarm.mapper.AlarmOccurrenceMapper">      <select id="listByAlarmEventId" resultType="com.fgroupboss.ai.psm.realtime.alarm.model.entity.AlarmOccurrenceEntity">         select * from alarm_occurrence         where tenant_id = #{tenantId}           and alarm_event_id = #{alarmEventId}         order by occurred_at desc, id desc     </select> </mapper>
<?xml version="1.0" encoding="UTF-8" ?> <!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"         "http://mybatis.org/dtd/mybatis-3-mapper.dtd"> <mapper namespace="com.fgroupboss.ai.psm.realtime.location.mapper.LocEventMapper">      <sql id="eventWhere">         tenant_id = #{tenantId}         <if test="eventType != null and eventType != ''">             and event_type = #{eventType}         </if>         <if test="tagNo != null and tagNo != ''">             and tag_no = #{tagNo}         </if>         <if test="personId != null">             and person_id = #{personId}         </if>         <if test="fromTime != null">             and event_time &gt;= #{fromTime}         </if>         <if test="toTime != null">             and event_time &lt;= #{toTime}         </if>     </sql>      <select id="countByTenant" resultType="long">         select count(1) from loc_event         <where>             <include refid="eventWhere"/>         </where>     </select>      <select id="listByTenant" resultType="com.fgroupboss.ai.psm.realtime.location.model.entity.LocEventEntity">         select * from loc_event         <where>             <include refid="eventWhere"/>         </where>         order by event_time desc         limit #{offset}, #{limit}     </select> </mapper>
<?xml version="1.0" encoding="UTF-8" ?> <!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"         "http://mybatis.org/dtd/mybatis-3-mapper.dtd"> <mapper namespace="com.fgroupboss.ai.psm.realtime.alarm.mapper.AlarmRuleMapper">      <select id="listByTenant" resultType="com.fgroupboss.ai.psm.realtime.alarm.model.entity.AlarmRuleEntity">         select * from alarm_rule         where tenant_id = #{tenantId}         <if test="ruleType != null and ruleType != ''">             and rule_type = #{ruleType}         </if>         order by id asc     </select>      <select id="listEnabledByType" resultType="com.fgroupboss.ai.psm.realtime.alarm.model.entity.AlarmRuleEntity">         select * from alarm_rule         where rule_type = #{ruleType}           and status = 'ENABLED'         order by tenant_id asc, id asc     </select>      <select id="findByCode" resultType="com.fgroupboss.ai.psm.realtime.alarm.model.entity.AlarmRuleEntity">         select * from alarm_rule         where tenant_id = #{tenantId}           and rule_code = #{ruleCode}         limit 1     </select> </mapper>
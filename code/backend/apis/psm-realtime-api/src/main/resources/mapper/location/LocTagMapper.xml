<?xml version="1.0" encoding="UTF-8" ?> <!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"         "http://mybatis.org/dtd/mybatis-3-mapper.dtd"> <mapper namespace="com.fgroupboss.ai.psm.realtime.location.mapper.LocTagMapper">      <sql id="tagWhere">         tenant_id = #{tenantId}         and deleted = 0         <if test="keyword != null and keyword != ''">             and tag_no like concat('%', #{keyword}, '%')         </if>         <if test="status != null and status != ''">             and status = #{status}         </if>     </sql>      <select id="countByTenant" resultType="long">         select count(1) from loc_tag         <where>             <include refid="tagWhere"/>         </where>     </select>      <select id="listByTenant" resultType="com.fgroupboss.ai.psm.realtime.location.model.entity.LocTagEntity">         select * from loc_tag         <where>             <include refid="tagWhere"/>         </where>         order by id desc         limit #{offset}, #{limit}     </select>      <select id="findByTagNo" resultType="com.fgroupboss.ai.psm.realtime.location.model.entity.LocTagEntity">         select * from loc_tag         where tenant_id = #{tenantId}           and tag_no = #{tagNo}           and deleted = 0         limit 1     </select> </mapper>
<?xml version="1.0" encoding="UTF-8" ?> <!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"         "http://mybatis.org/dtd/mybatis-3-mapper.dtd"> <mapper namespace="com.fgroupboss.ai.psm.realtime.location.mapper.VisitorAccessRecordMapper">      <sql id="visitorWhere">         tenant_id = #{tenantId}         <if test="visitorName != null and visitorName != ''">             and visitor_name like concat('%', #{visitorName}, '%')         </if>         <if test="gateCode != null and gateCode != ''">             and gate_code = #{gateCode}         </if>         <if test="fromTime != null">             and access_time &gt;= #{fromTime}         </if>         <if test="toTime != null">             and access_time &lt;= #{toTime}         </if>     </sql>      <select id="countByTenant" resultType="long">         select count(1) from visitor_access_record         <where>             <include refid="visitorWhere"/>         </where>     </select>      <select id="listByTenant" resultType="com.fgroupboss.ai.psm.realtime.location.model.entity.VisitorAccessRecordEntity">         select * from visitor_access_record         <where>             <include refid="visitorWhere"/>         </where>         order by access_time desc         limit #{offset}, #{limit}     </select> </mapper>
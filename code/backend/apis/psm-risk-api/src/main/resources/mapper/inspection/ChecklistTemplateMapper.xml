<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fgroupboss.ai.psm.risk.inspection.mapper.ChecklistTemplateMapper">

    <sql id="templateWhere">
        tenant_id = #{tenantId}
        and deleted = 0
        <if test="keyword != null and keyword != ''">
            and (template_code like concat('%', #{keyword}, '%')
            or template_name like concat('%', #{keyword}, '%'))
        </if>
    </sql>

    <select id="countByTenant" resultType="long">
        select count(1) from insp_checklist_template
        <where>
            <include refid="templateWhere"/>
        </where>
    </select>

    <select id="listByTenant" resultType="com.fgroupboss.ai.psm.risk.inspection.model.entity.ChecklistTemplateEntity">
        select * from insp_checklist_template
        <where>
            <include refid="templateWhere"/>
        </where>
        order by id desc
        limit #{offset}, #{limit}
    </select>

    <select id="findByCode" resultType="com.fgroupboss.ai.psm.risk.inspection.model.entity.ChecklistTemplateEntity">
        select * from insp_checklist_template
        where tenant_id = #{tenantId}
          and template_code = #{templateCode}
          and deleted = 0
        limit 1
    </select>
</mapper>

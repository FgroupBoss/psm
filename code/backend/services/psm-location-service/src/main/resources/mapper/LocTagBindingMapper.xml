<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fgroupboss.ai.psm.location.mapper.LocTagBindingMapper">

    <select id="findActiveByTagNo" resultType="com.fgroupboss.ai.psm.location.model.entity.LocTagBindingEntity">
        select * from loc_tag_binding
        where tenant_id = #{tenantId}
          and tag_no = #{tagNo}
          and status = 'ACTIVE'
          and deleted = 0
        order by id desc
        limit 1
    </select>
</mapper>

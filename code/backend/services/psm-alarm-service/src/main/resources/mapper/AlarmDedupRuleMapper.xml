<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fgroupboss.ai.psm.alarm.mapper.AlarmDedupRuleMapper">

    <select id="findBySourceType" resultType="com.fgroupboss.ai.psm.alarm.model.entity.AlarmDedupRuleEntity">
        select * from alarm_dedup_rule
        where tenant_id = #{tenantId}
          and source_type = #{sourceType}
          and enabled = 1
        order by id desc
        limit 1
    </select>
</mapper>

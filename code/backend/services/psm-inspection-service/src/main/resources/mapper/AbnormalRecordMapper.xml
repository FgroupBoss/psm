<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fgroupboss.ai.psm.inspection.mapper.AbnormalRecordMapper">

    <select id="listByTask" resultType="com.fgroupboss.ai.psm.inspection.model.entity.AbnormalRecordEntity">
        select * from insp_abnormal_record
        where tenant_id = #{tenantId}
          and task_id = #{taskId}
        order by id desc
    </select>
</mapper>

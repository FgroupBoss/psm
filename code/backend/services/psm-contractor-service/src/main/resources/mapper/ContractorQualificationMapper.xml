<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fgroupboss.ai.psm.contractor.mapper.ContractorQualificationMapper">

    <select id="listByCompany" resultType="com.fgroupboss.ai.psm.contractor.model.entity.ContractorQualificationEntity">
        select * from contractor_qualification
        where tenant_id = #{tenantId}
          and company_id = #{companyId}
          and deleted = 0
        order by core_flag desc, id desc
    </select>
</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fgroupboss.ai.psm.contractor.mapper.WorkerCertificateMapper">

    <select id="listByWorker" resultType="com.fgroupboss.ai.psm.contractor.model.entity.WorkerCertificateEntity">
        select * from worker_certificate
        where tenant_id = #{tenantId}
          and worker_id = #{workerId}
          and deleted = 0
        order by id desc
    </select>
</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fgroupboss.ai.psm.majorhazard.mapper.MajorHazardAttachmentMapper">

    <select id="listByHazardId"
            resultType="com.fgroupboss.ai.psm.majorhazard.model.entity.MajorHazardAttachmentEntity">
        select * from major_hazard_attachment
        where tenant_id = #{tenantId}
          and hazard_id = #{hazardId}
          and deleted = 0
        order by id desc
    </select>
</mapper>

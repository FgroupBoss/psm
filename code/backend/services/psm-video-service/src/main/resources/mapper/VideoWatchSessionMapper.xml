<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fgroupboss.ai.psm.video.mapper.VideoWatchSessionMapper">

    <select id="findActiveByPermit" resultType="com.fgroupboss.ai.psm.video.model.entity.VideoWatchSessionEntity">
        select * from video_watch_session
        where tenant_id = #{tenantId}
          and work_permit_id = #{workPermitId}
          and status = 'ACTIVE'
          and deleted = 0
        order by id desc
        limit 1
    </select>
</mapper>

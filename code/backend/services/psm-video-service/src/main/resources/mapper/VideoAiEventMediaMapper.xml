<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fgroupboss.ai.psm.video.mapper.VideoAiEventMediaMapper">

    <select id="listByEventId" resultType="com.fgroupboss.ai.psm.video.model.entity.VideoAiEventMediaEntity">
        select * from video_ai_event_media
        where tenant_id = #{tenantId}
          and event_id = #{eventId}
          and deleted = 0
        order by id asc
    </select>
</mapper>

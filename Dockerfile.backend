FROM eclipse-temurin:8-jre

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}

RUN groupadd -r psm && useradd -r -g psm psm

COPY code/backend/apis/${SERVICE_NAME}/target/${SERVICE_NAME}-1.0.0-SNAPSHOT.jar /app/app.jar

RUN mkdir -p /app/data && chown -R psm:psm /app

USER psm
WORKDIR /app

EXPOSE 18080 18087 18088 18101 18111 18115

ENTRYPOINT ["sh", "-c", "java -jar /app/app.jar"]
